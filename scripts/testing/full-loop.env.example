# Hetzner Cloud API token
# Create at: cloud.hetzner.com → Security → API Tokens → Generate API Token (Read & Write)
HCLOUD_TOKEN=

# Namecheap API credentials
# Enable at: ap.www.namecheap.com/settings/tools/apiaccess
# Whitelist your outbound IP there too.
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=
# Your outbound IP — must be whitelisted in Namecheap API access settings.
NAMECHEAP_CLIENT_IP=

# Wildcard domain for the test instance (must match a domain managed by Namecheap above).
# Creates *.sub.example.com and sub.example.com A records pointing to the server.
DOMAIN=*.test.tagsyo.com

# Admin email for the sitey instance.
EMAIL=

# SSH key registered in Hetzner Cloud (used to access the new server).
# Value can be the key name (string) or numeric ID from cloud.hetzner.com → Security → SSH Keys.
HETZNER_SSH_KEY=

# Local private key matching the above Hetzner SSH key.
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519_sitey_test

# Optional: Hetzner server size and datacenter.
# Sizes: cx22 (~4 EUR/mo), cx32, cpx21, etc.
# Locations: nbg1, fsn1, hel1, ash, hil
HETZNER_SERVER_TYPE=cx22
HETZNER_LOCATION=nbg1

# Optional: milliseconds to wait for DNS propagation after setHosts before running Playwright.
# Namecheap usually propagates within 30s. Default: 45000
DNS_PROPAGATION_WAIT_MS=45000
