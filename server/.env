# Defaults for running the server natively (`npm run dev` in server/), which the
# local e2e suite does; it overrides DATABASE_URL, PORT and the Caddy/GitHub URLs.
# Containers (dev:docker and production) get their env from docker-compose instead.
DATABASE_URL="file:../../deploy/data/sitey.db"
JWT_SECRET="dev-insecure-change-me-in-production"
ADMIN_EMAIL="your.email@example.com"
DATA_ROOT="./data"
PORT=3001
LOG_LEVEL=debug
SITEY_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
