generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tokens             Token[]
}

model Token {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique              // SHA-256 hex of the raw token
  type       String                         // "session" | "apikey"
  name       String?                        // null for sessions; user-provided label for API keys
  expiresAt  DateTime?                      // null = never expires (API keys); set for sessions
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Domain {
  id                     Int            @id @default(autoincrement())
  hostname               String         @unique
  letsEncryptEmail       String
  status                 String         @default("pending") // pending | active | error
  statusCheckedAt        DateTime?
   // wildcard only: serve sitey panel at sitey.<base>
  siteySubdomainsEnabled Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  routes                 ServiceRoute[]
}

// ── Repo / Service split ──────────────────────────────────────────────────────
// Repo = source identity + integration config.
// Service = deployable unit + runtime/build settings.

model Repo {
  id         Int      @id @default(autoincrement())
  name       String   @default("")
  repoOwner  String   @default("")
  repoName   String   @default("")
  githubMode String   @default("webhook") // webhook | app
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  services      Service[]
  hookEndpoints HookEndpoint[]
}

model Service {
  id     Int    @id @default(autoincrement())
  name   String

  repoId Int
  repo   Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  // Default branch for deployments
  branch String @default("main")

  // Deploy mode
  deployMode    String @default("server") // server | static
  buildCommand  String @default("")       // e.g. "npm run build"
  outputDir     String @default("")       // static: output directory (empty = repo root)
  buildImage    String @default("")       // static: Docker image for build (e.g. oven/bun:1)

  // Build / run
  buildMode        String @default("auto") // auto | dockerfile
  dockerfilePath   String @default("") // path to Dockerfile relative to repo root
  serverRunCommand String @default("") // custom CMD for auto-generated server Dockerfile
  containerPort    Int    @default(3000)
  hostPort      Int?           // auto-allocated fallback port when the service has no routes
  envVars       String         @default("") // .env format

  // Runtime state
  status        String  @default("idle") // idle | building | running | failed | stopped
  containerId   String?
  containerName String?

  // System-managed services (e.g. the sitey UI itself) cannot be deleted
  protected     Boolean @default(false)

  // When deactivated, container is stopped and Caddy routes are removed (data is kept)
  active        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routes      ServiceRoute[]
  deployments Deployment[]
}

// Decoupled webhook endpoint with opaque public ID.
// URL: POST /api/hook/:publicId
model HookEndpoint {
  id         String  @id @default(cuid())
  publicId   String  @unique           // opaque random ID for URL
  secret     String                    // for signature verification
  sourceType String                    // github_webhook | github_app | generic
  repoId     Int?
  repo       Repo?   @relation(fields: [repoId], references: [id], onDelete: Cascade)
  enabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A route is a (domain, subdomain, pathPrefix) tuple that points traffic to a service.
model ServiceRoute {
  id          String   @id @default(cuid())
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  domainId    Int?
  domain      Domain?  @relation(fields: [domainId], references: [id], onDelete: Cascade)

  subdomain   String   @default("") // used when domain.hostname starts with "*."
  pathPrefix  String   @default("") // e.g. "/blog" — empty means the root of this host

  // Protected routes cannot be deleted (used for the sitey root route)
  protected   Boolean  @default(false)

  // TLS certificate status for this specific route hostname.
  tlsStatus   String   @default("unchecked") // unchecked | active | error

  // Serve this hostname over plain HTTP only (no HTTPS block).
  httpOnly    Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@unique([domainId, subdomain, pathPrefix])
}

model Deployment {
  id          String    @id @default(cuid())
  serviceId   Int
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  status        String    @default("queued") // queued | building | running | success | failed
  commitSha     String?
  commitMessage String?
  logPath       String?
  triggeredBy   String    @default("manual") // manual | hook

  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model DomainStats {
  id           Int    @id @default(autoincrement())
  hostname     String
  date         String // YYYY-MM-DD
  requestCount Int    @default(0)
  errorCount   Int    @default(0) // 4xx + 5xx responses

  @@unique([hostname, date])
  @@index([hostname])
  @@index([date])
}

// Key-value store for system-wide settings
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model GithubIntegration {
  id            Int      @id @default(1)
  appId         String?
  privateKey    String?
  webhookSecret String?
  appSlug       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
