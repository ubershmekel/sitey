{
  "name": "sitey",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:docker": "docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml up --build",
    "dev:nocaddy": "concurrently \"npm run dev -w server\" \"npm run dev -w web\"",
    "prepare": "husky",
    "build": "npm run build -w web && npm run build -w server",
    "typecheck": "npm run db:generate -w server && npm run typecheck -w server && npm run typecheck -w web && tsc --noEmit -p e2e/tsconfig.json",
    "test": "npm run test -w server",
    "check:all": "npm run format:check && npm run typecheck && npm run db:check -w server && npm run test",
    "format": "prettier --write .",
    "format:staged": "lint-staged",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w server",
    "db:studio": "npm run db:studio -w server",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:mockserver": "tsx e2e/mock-external-server.ts",
    "test:remote-wipe-and-test": "node scripts/testing/remote-test-wipe.ts",
    "test:remote-test-install": "node scripts/testing/remote-test-install.ts",
    "test:full-loop": "node scripts/testing/full-loop.ts"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2"
  }
}
