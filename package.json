{
  "name": "sitey",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:docker": "docker compose -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml up --build",
    "dev:nocaddy": "concurrently \"npm run dev -w server\" \"npm run dev -w web\"",
    "prepare": "husky",
    "build": "npm run build -w web",
    "dev:e2e-mockserver": "node e2e/local/mock-external-server.ts",
    "format": "prettier --write .",
    "format:staged": "lint-staged",
    "db:migrate": "npm run db:migrate -w server",
    "db:studio": "npm run db:studio -w server",
    "test:format": "prettier --check .",
    "test:types": "npm run db:generate -w server && npm run typecheck -w server && npm run typecheck -w web && tsc --noEmit -p e2e/local/tsconfig.json && npm run db:check -w server",
    "test:unit": "npm run test -w server",
    "test:e2e-local": "playwright test --config e2e/local/playwright.config.ts",
    "test:e2e-remote": "node e2e/remote/full-loop.ts",
    "test:all": "npm run test:format && npm run test:types && npm run test:unit && npm run test:e2e-local && npm run test:e2e-remote"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2"
  }
}
