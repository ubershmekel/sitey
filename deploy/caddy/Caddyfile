# Bootstrap config — loaded when Caddy starts.
# sitey-api pushes an updated config via POST /load over the admin Unix socket on startup
# and whenever domains/deployments change (to add user domain blocks).
# This file only handles the management UI — it never needs to change.
#
# Note: no access-log block here. The real config pushed by sitey-api adds the
# privacy-filtered access log (tagged with the sitey service's real id, which
# this static file can't look up). The ~second before that push isn't recorded —
# acceptable for best-effort analytics. See docs/design/analytics.md.
{
    admin unix//run/caddy-admin/admin.sock
}

:80 {
    handle /api/* {
        reverse_proxy sitey-api:3001
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
