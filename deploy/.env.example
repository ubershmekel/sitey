# Optional: override the data directory on the host (default: ./data)
# DATA_ROOT=/opt/sitey/data

# Optional: log level — debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Required when using buildImage with a custom DATA_ROOT.
# Must be the absolute host path that maps to /data inside the sitey-api container.
# If unset, sitey auto-detects from the container's own mounts.
# HOST_DATA_ROOT=/opt/sitey/data
